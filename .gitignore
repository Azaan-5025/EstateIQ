*.sqlite3

# Data files (track structure via .gitkeep, ignore large intermediate training datasets)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
*.csv
*.parquet
*.xlsx
*.xls
*.zip
*.tar.gz

# Explicitly allow runtime cleaned dataset for Streamlit deployment (47.19 MB)
!data/processed/india_housing_cleaned.csv

# Trained Model Artifacts
models/*
!models/.gitkeep
*.pkl
*.joblib
*.onnx
*.h5
*.pt

# Explicitly allow production model artifacts and metadata JSONs
!models/best_classification_model.joblib
!models/best_regression_model.joblib
!models/classification_model_metadata.json
!models/regression_model_metadata.json

# Generated Reports (keep folder structure)
reports/*.html
reports/*.pdf
!reports/.gitkeep
